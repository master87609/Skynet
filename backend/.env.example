# ═══════════════════════════════════════════════════════════
# SKYNET AI Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════

# ── App Settings ─────────────────────────────────────────────
APP_NAME="SKYNET AI Backend"
APP_VERSION="1.0.0"
DEBUG=true
SECRET_KEY="CHANGE_ME_to_a_random_64_char_secret"

# ── CORS ─────────────────────────────────────────────────────
# Frontend origins allowed to call this API
ALLOWED_ORIGINS=["http://localhost:8080", "http://127.0.0.1:8080", "http://localhost:3000"]

# ── PostgreSQL ───────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/skynet_db

# ── MongoDB ──────────────────────────────────────────────────
# Format: mongodb://user:password@host:port/
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=skynet_logs

# ── Google OAuth2 ────────────────────────────────────────────
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ── Google Gemini API ────────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_DEFAULT_MODEL=gemini-2.0-flash-exp

# ── JWT Auth Tokens ───────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Subscription Plans (INR) ─────────────────────────────────
PLAN_FREE_PRICE=0
PLAN_PRO_PRICE_MONTHLY=2399
PLAN_PRO_PRICE_YEARLY=1999
PLAN_MAX_PRICE=11999
